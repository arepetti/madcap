{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Debate": {
    "Provider": "FoundryLocal",
    "PersonaDirectory": null,
    "Defaults": {
      "Persona": "default",
      "AnswererTemp": 0.3,
      "CriticTemp": 0.9,
      "JudgeTemp": 0.3,
      "BuildProfile": true,
      "MaxRounds": 3
    },
    "FoundryLocal": {
      "AppName": "debate",
      "ModelCacheDir": "",
      "RegisterExecutionProviders": true,
      "ExecutionProvider": "auto",
      "ContextSize": 8192,
      "RequestTimeoutSeconds": 600,
      "WebServiceUrl": "http://127.0.0.1:0",
      "SeparateWindows": true,
      "Profile": "small",
      "Profiles": {
        "normal": {
          "Answerer": "phi-4",
          "Critic": "mistral-7b-v0.2",
          "Judge": "qwen3-8b",
          "ExecutionProvider": "cuda",
          "ExecutionMode": "Parallel",
          "MaxOutputTokens": {
            "Answerer": null,
            "Critic": null,
            "Judge": 2048
          }
        },
        "small": {
          "Answerer": "phi-4",
          "Critic": "ministral-3-3b-instruct-2512",
          "Judge": "qwen3-4b",
          "ExecutionProvider": "cuda",
          "ExecutionMode": "SemiSequential",
          "MaxOutputTokens": {
            "Answerer": null,
            "Critic": null,
            "Judge": 2048
          }
        },
        "smaller": {
          "Answerer": "phi-4-mini",
          "Critic": "ministral-3-3b-instruct-2512",
          "Judge": "qwen3-4b",
          "ExecutionProvider": "cuda",
          "ExecutionMode": "SemiSequential",
          "MaxOutputTokens": {
            "Answerer": null,
            "Critic": null,
            "Judge": 2048
          }
        }
      }
    },
    "Remote": {
      "Endpoint": "https://api.openai.com/v1",
      "ApiKeyEnvVar": "DEBATE_API_KEY",
      "ContextSize": 128000,
      "Models": {
        "Answerer": "gpt-4o-mini",
        "Critic": "gpt-4.1-mini",
        "Judge": "gpt-4o"
      }
    }
  }
}
